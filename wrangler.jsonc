{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trade-finder",
  "main": "worker.js",
  "compatibility_date": "2026-04-27",
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application"
  },
  "kv_namespaces": [
    {
      "binding": "MARKET_CACHE",
      "id": "cc6f5f1f2ee1408cbdcbe52977df2eaf",
      // For local dev, create a preview namespace: npx wrangler kv namespace create MARKET_CACHE --preview
      "preview_id": "YOUR_PREVIEW_KV_NAMESPACE_ID"
    }
  ],
  "triggers": {
    "crons": ["5 * * * *"]
  }
}
